# Docker Environment Configuration
PYTHONUNBUFFERED=1
APP_ENV=production

# FastAPI Settings
FASTAPI_ENV=production

# Database (SQLite file will be persisted via Docker volume)
DATABASE_URL=sqlite:///./knowledgevault.db

# CORS Settings (adjust as needed for your domain)
CORS_ORIGINS=["http://localhost:8000","http://localhost:8080","http://localhost"]
